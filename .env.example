# Chatbot dùng Ollama (chạy local, miễn phí) — không cần API key.
# Các biến dưới đây là TÙY CHỌN, chỉ cần sửa nếu bạn muốn đổi model hoặc
# Ollama chạy ở địa chỉ khác mặc định. Copy file này thành ".env" nếu muốn dùng.

# Model đã "ollama pull" — đổi nếu bạn dùng model khác (VD: qwen2.5:7b, llama3.2:3b)
OLLAMA_MODEL=llama3.1:8b

# Địa chỉ Ollama server (mặc định khi cài Ollama trên máy)
OLLAMA_BASE_URL=http://localhost:11434

# Giới hạn số token sinh ra tối đa mỗi câu trả lời (số nhỏ hơn = nhanh hơn)
OLLAMA_NUM_PREDICT=400

# --- RAG (tùy chọn, chỉ cần nếu đã chạy python rag/build_index.py) ---
# Model dùng để tính embedding — nhẹ hơn nhiều so với model chat
OLLAMA_EMBED_MODEL=nomic-embed-text
# Ngưỡng cosine similarity để quyết định có dùng RAG hay không (0-1).
# Thấp hơn = dễ kích hoạt RAG hơn (nhưng dễ chèn tài liệu không liên quan).
# Cao hơn = chỉ kích hoạt khi câu hỏi rất khớp tài liệu (an toàn hơn nhưng dễ bỏ sót).
RAG_SIMILARITY_THRESHOLD=0.5
# Số chunk tài liệu lấy về mỗi lần kích hoạt RAG
RAG_TOP_K=3
