FROM python:3.10-slim

WORKDIR /app

COPY requirements-prod.txt .
RUN pip install --no-cache-dir -r requirements-prod.txt

COPY config/ config/
COPY src/ src/
COPY api/ api/
COPY models/ models/

ENV PYTHONPATH=/app
ENV BASIC_CONFIG_PATH=config/basic/prod.yaml
ENV ADVANCED_CONFIG_PATH=config/advanced/prod.yaml

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
